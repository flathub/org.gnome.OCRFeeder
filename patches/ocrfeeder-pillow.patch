Date: Sun, 22 Mar 2026 11:23:47 +0000
Subject: [PATCH] Fix compatibility with Pillow>=10

`Image.ANTIALIAS` has been replaced by `Image.LANCZOS`.
---
 src/ocrfeeder/studio/widgetPresenter.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/ocrfeeder/studio/widgetPresenter.py b/src/ocrfeeder/studio/widgetPresenter.py
index 47a8ca9..ce069ba 100644
--- a/src/ocrfeeder/studio/widgetPresenter.py
+++ b/src/ocrfeeder/studio/widgetPresenter.py
@@ -987,7 +987,7 @@ class UnpaperDialog(Gtk.Dialog):
         except Exception as exception:
             debug(exception.message)
             return
-        thumbnail_image.thumbnail((150, 200), Image.ANTIALIAS)
+        thumbnail_image.thumbnail((150, 200), Image.LANCZOS)
         image_thumbnail_path = lib.getNonExistingFileName(name + '_thumb.png')
         thumbnail_image.save(image_thumbnail_path, format = 'PNG')
         image = Gtk.Image.new_from_file(image_thumbnail_path)
